# Copy to .env beside config.toml. Config changes are reloaded automatically.
# Process environment variables take precedence. Never commit .env.
TELEGRAM_BOT_TOKEN=PUT_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=-1001234567890
# Required only for translation.provider=google_cloud.
GOOGLE_TRANSLATE_API_KEY=
# Optional second group for important listings (priority.send_to_group = true).
TELEGRAM_PRIORITY_CHAT_ID=
# Optional comma-separated lists, added to config.toml [priority]. Norwegian words / 4-digit postal codes.
PRIORITY_KEYWORDS=
PRIORITY_POSTAL_CODES=
